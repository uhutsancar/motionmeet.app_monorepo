{
  "name": "motionmeet-monorepo",
  "version": "1.0.0",
  "description": "MotionMeet - Social media app for athletes",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "**/expo",
      "**/expo/**",
      "**/metro",
      "**/metro/**",
      "**/metro-*",
      "**/@expo/**",
      "**/react-native",
      "**/react-native/**",
      "**/babel-preset-expo",
      "**/jest-expo"
    ]
  },
  "scripts": {
    "all": "concurrently \"npm run dev:backend\" \"npm run dev:web\" \"npm run dev:mobile\" --names \"backend,web,mobile\" --prefix-colors \"blue,green,yellow\"",
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=@motionmeet/backend",
    "dev:web": "npm run dev --workspace=@motionmeet/web",
    "dev:mobile": "npm run dev --workspace=@motionmeet/mobile",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace=@motionmeet/backend",
    "test:web": "npm run test --workspace=@motionmeet/web",
    "test:mobile": "npm run test --workspace=@motionmeet/mobile",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
