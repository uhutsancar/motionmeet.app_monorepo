{
  "name": "motionmeet-monorepo",
  "version": "1.0.0",
  "description": "MotionMeet - Social media app for athletes",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@motionmeet/backend",
    "dev:web": "npm run dev --workspace=@motionmeet/web",
    "test:backend": "npm run test --workspace=@motionmeet/backend",
    "test:web": "npm run test --workspace=@motionmeet/web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {}
}
