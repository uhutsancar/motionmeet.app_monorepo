{
  "name": "motionmeet-monorepo",
  "version": "1.0.0",
  "description": "MotionMeet - Social media app for athletes",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "brand": "node scripts/generate-brand-assets.mjs",
    "local:ip": "node scripts/local-network.mjs ip",
    "dev:local": "node scripts/local-network.mjs all",
    "dev:local:backend": "node scripts/local-network.mjs backend",
    "dev:local:web": "node scripts/local-network.mjs web",
    "dev:local:mobile": "node scripts/local-network.mjs mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "security:node": "node scripts/check-node-security.mjs --scan",
    "security:audit": "node scripts/check-dependency-audit.mjs",
    "docker:dev": "docker compose up --build",
    "docker:prod:config": "docker compose -f docker-compose.prod.yml config",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "dev:backend": "turbo run dev --filter=@motionmeet/backend",
    "dev:web": "turbo run dev --filter=@motionmeet/web",
    "dev:mobile": "node scripts/local-network.mjs mobile lan",
    "dev:mobile:usb": "node scripts/local-network.mjs mobile usb",
    "dev:mobile:clean": "node scripts/local-network.mjs mobile lan clear"
  },
  "devDependencies": {
    "metro-runtime": "~0.83.3",
    "sharp": "^0.35.5",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25"
  }
}
