# Exact patched Node.js release, pinned by index digest. Raise every stage
# together with the minimums in scripts/check-node-security.mjs.
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.10.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY patches ./patches
COPY packages/backend/package.json ./packages/backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json
RUN pnpm install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY packages/backend ./packages/backend
RUN pnpm --filter @motionmeet/shared build && pnpm --filter @motionmeet/backend build

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS dependencies

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.10.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY packages/backend/package.json ./packages/backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json
RUN pnpm install --frozen-lockfile --prod --filter @motionmeet/backend...

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runtime

ENV NODE_ENV=production
# The root filesystem is read-only in production; /tmp is the tmpfs Compose
# mounts, so fontconfig keeps its per-process cache there.
ENV XDG_CACHE_HOME=/tmp/.cache
WORKDIR /app
# fontconfig and a real font family are what sharp needs to draw the type on a
# share card; without them every label rasterises as empty boxes.
# The runtime only ever runs `node`. The npm, Corepack and Yarn CLIs bundled
# with the base image are dead weight here, and image scanners flag the
# dependencies npm vendors (undici, brace-expansion, http-cache-semantics).
RUN apk add --no-cache tini fontconfig ttf-dejavu \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v* \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /app/packages/backend/node_modules ./packages/backend/node_modules
COPY --from=build --chown=node:node /app/packages/backend/package.json ./packages/backend/package.json
COPY --from=build --chown=node:node /app/packages/backend/dist ./packages/backend/dist
COPY --from=build --chown=node:node /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build --chown=node:node /app/packages/shared/dist ./packages/shared/dist

USER node
WORKDIR /app/packages/backend
EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
