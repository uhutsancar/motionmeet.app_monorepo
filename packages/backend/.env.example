# Database
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=motionmeet
REDIS_URL=redis://localhost:6379

# Server
PORT=4000
NODE_ENV=production
RUN_SCHEDULED_JOBS=true
MEDIA_UPLOADS_ENABLED=true
EMAIL_ENABLED=true

# Browser origin and links used in email
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Authentication (generate a unique value with at least 32 random bytes)
JWT_SECRET=replace-with-at-least-32-random-bytes

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=

# SMTP
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
