# PostgreSQL and Redis
DATABASE_URL=postgresql://motionmeet:<password>@postgres:5432/motionmeet
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=30
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
REDIS_URL=rediss://default:<password>@redis.example.com:6379
# Only for a trusted private self-hosted network; managed production should use TLS.
ALLOW_INSECURE_REDIS_TLS=false

# Server
PORT=4000
NODE_ENV=production
RUN_SCHEDULED_JOBS=true
GLOBAL_RATE_LIMIT_PER_15_MIN=1000
MEDIA_UPLOADS_ENABLED=true
EMAIL_ENABLED=true

# Browser origin and links used in email
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Authentication (generate a unique value with at least 32 random bytes)
JWT_SECRET=REPLACE_ME

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=

# SMTP
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
