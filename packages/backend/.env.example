# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=motionmeet

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production   # development | production

# ── Frontend URL (CORS + email redirect links) ───────────────────────────────
# Local dev  → http://localhost:5173  (set in .env.local, NOT here)
# Production → your CloudFront / custom domain
FRONTEND_URL=https://your-cloudfront-or-domain.com
# Comma-separated browser origins. Native mobile requests do not send an Origin header.
CORS_ORIGINS=https://your-web-domain.com,http://localhost:5173

# ── Custom Authentication ─────────────────────────────────────────────────────
JWT_SECRET=supersecret
JWT_EXPIRES_IN=30d

# ── ImageKit (media CDN) ─────────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# ── AWS S3 (file/video storage) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=

# ── Email / SMTP (Brevo or similar) ──────────────────────────────────────────
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT OVERRIDES
# Create .env.local with just the values you want to override:
#
#   NODE_ENV=development
#   FRONTEND_URL=http://localhost:5173
#   PORT=4000
#
# .env.local is loaded AFTER .env and takes precedence.
# ─────────────────────────────────────────────────────────────────────────────
