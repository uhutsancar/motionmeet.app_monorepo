# PostgreSQL and Redis
DATABASE_URL=postgresql://motionmeet:<password>@postgres:5432/motionmeet
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=30
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
REDIS_URL=rediss://default:<password>@redis.example.com:6379
# Only for a trusted private self-hosted network; managed production should use TLS.
ALLOW_INSECURE_REDIS_TLS=false

# Server
PORT=4000
NODE_ENV=production
# true runs housekeeping and the outbox inside the API process (single-process
# development). Production sets false and runs entrypoints/worker + scheduler.
RUN_SCHEDULED_JOBS=true
RUN_MIGRATIONS=true
GLOBAL_RATE_LIMIT_PER_15_MIN=1000
MEDIA_UPLOADS_ENABLED=true
EMAIL_ENABLED=true
# Private listener for /metrics and health (worker, scheduler, API). Never route it publicly.
# METRICS_PORT=9464
# With several API replicas behind a load balancer, Redis carries the Socket.IO
# adapter and the shared rate limits; true reports not-ready without it.
READINESS_REQUIRE_REDIS=false

# Outbox delivery: direct (handled in-process, no broker) or rabbitmq (worker publishes with confirms)
OUTBOX_TRANSPORT=direct
# RABBITMQ_URL=amqps://motionmeet:<password>@rabbitmq.example.com:5671/motionmeet
# Only for a trusted private network; production should use amqps://.
ALLOW_INSECURE_RABBITMQ_TLS=false
# quorum (default, replicated on a cluster) or classic
# RABBITMQ_QUEUE_TYPE=quorum
# RABBITMQ_PREFETCH=10
# OUTBOX_POLL_INTERVAL_MS=1000
# ffprobe binary the media worker uses to measure videos (shipped in the
# worker's media-runtime image). Without it videos keep null duration/size.
# FFPROBE_PATH=ffprobe

# Browser origin and links used in email
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Authentication (generate a unique value with at least 32 random bytes)
JWT_SECRET=REPLACE_ME

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>
# Extra hosts the server may download media from (comma separated), besides the ImageKit endpoint.
# MEDIA_FETCH_ALLOWED_HOSTS=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=

# SMTP
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
