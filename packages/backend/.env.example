# Database
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
# Development ortamı için "motionmeet_dev", Production için "motionmeet" kullanın
MONGODB_DB_NAME=motionmeet
MONGODB_APP_NAME=motionmeet-api
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_WAIT_QUEUE_TIMEOUT_MS=3000
MONGODB_MAX_TIME_MS=15000
MONGODB_MAX_IDLE_TIME_MS=30000
REDIS_URL=rediss://default:<password>@redis.example.com:6379
# Only for a trusted private self-hosted network; managed production should use TLS.
ALLOW_INSECURE_MONGO_TLS=false
ALLOW_INSECURE_REDIS_TLS=false

# Server
PORT=4000
NODE_ENV=production
RUN_SCHEDULED_JOBS=true
GLOBAL_RATE_LIMIT_PER_15_MIN=1000
MEDIA_UPLOADS_ENABLED=true
EMAIL_ENABLED=true

# Browser origin and links used in email
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Authentication (generate a unique value with at least 32 random bytes)
JWT_SECRET=REPLACE_ME

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=

# SMTP
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
