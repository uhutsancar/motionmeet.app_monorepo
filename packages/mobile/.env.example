# `pnpm dev:local:mobile` detects the active LAN IPv4 address and injects
# all three values below. Set them manually only when bypassing that command.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Avoid Expo CLI's optional online dependency-version lookup during Metro start.
# Dependency compatibility remains enforced by Expo Doctor in validation/CI.
EXPO_NO_DEPENDENCY_VALIDATION=1

# AdMob native App IDs, read by app.config.js at `expo prebuild` time and
# baked into AndroidManifest.xml/Info.plist. Not secrets - safe to use a real
# one. Omit entirely to fall back to Google's public sample App IDs. Ad unit
# ids stay Google's TestIds regardless of this value until production ad
# units are configured in src/config/ads.ts - see docs/mobile-admob.md.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511

# Master ad switch. Leave unset (ads on) unless a build must not fetch ads
# at all - see src/config/ads.ts.
# EXPO_PUBLIC_ADS_ENABLED=false
