# Android emulator: http://10.0.2.2:4000
# iOS simulator: http://localhost:4000
# Physical devices and production builds need a reachable HTTPS/LAN origin.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Avoid Expo CLI's optional online dependency-version lookup during Metro start.
# Dependency compatibility remains enforced by Expo Doctor in validation/CI.
EXPO_NO_DEPENDENCY_VALIDATION=1
