{
  "expo": {
    "name": "MotionMeet",
    "slug": "motionmeet",
    "version": "1.0.0",
    "scheme": "motionmeet",
    "orientation": "portrait",
    "icon": "./assets/motionmeet-icon-v2.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/motionmeet-icon-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#100A45"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.motionmeet.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.motionmeet.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/motionmeet-icon-v2.png",
        "backgroundColor": "#100A45"
      }
    },
    "web": {
      "favicon": "./assets/motionmeet-icon-v2.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "MotionMeet uses your selected photo only when you choose media to share or update your profile.",
          "cameraPermission": "MotionMeet uses your camera only when you choose to capture a workout photo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
