{
  "expo": {
    "name": "MotionMeet",
    "slug": "motionmeet",
    "version": "1.0.0",
    "scheme": "motionmeet",
    "orientation": "portrait",
    "icon": "./assets/motionmeet-icon-v2.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/motionmeet-icon-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#100A45"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.motionmeet.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.motionmeet.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/motionmeet-icon-v2.png",
        "backgroundColor": "#100A45"
      }
    },
    "web": {
      "favicon": "./assets/motionmeet-icon-v2.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "MotionMeet uses your selected photo only to update your profile or cover image."
        }
      ]
    ]
  }
}
