{
  "expo": {
    "name": "MotionMeet",
    "slug": "motionmeet",
    "version": "1.1.0",
    "scheme": "motionmeet",
    "orientation": "portrait",
    "//locales": "The app is Turkish-first, so iOS shows its own permission prompts in Turkish rather than falling back to the English strings below.",
    "locales": {
      "tr": "./locales/tr.json"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0630"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.motionmeet.mobile",
      "buildNumber": "2"
    },
    "android": {
      "package": "app.motionmeet.mobile",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0630"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "MotionMeet uses your selected photo only when you choose media to share or update your profile.",
          "cameraPermission": "MotionMeet uses your camera only when you choose to capture a workout photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationWhenInUsePermission": "MotionMeet uses your location to show athletes near you while the Nearby screen is open.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withLoopbackCleartext"
    ]
  }
}
