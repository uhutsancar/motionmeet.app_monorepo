{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": ["vite/client"],
    // No `baseUrl`: it is deprecated and stops working in TypeScript 7. Since
    // TypeScript 5 `paths` entries resolve relative to this file on their own,
    // which is why the mapping below is written as an explicit relative path.
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "vite.config.ts"]
}
