VITE_BASEURL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# Paddle checkout. Client-side token only (never the secret API key) - safe
# to expose in the built bundle. Leave unset to keep checkout disabled.
# Sandbox tokens are prefixed test_; a live token has no prefix and must not
# be used unless VITE_PADDLE_ENVIRONMENT=live. See docs/paddle-integration-plan.md.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
