# Copy to .env.production and replace every example value before deployment.
NODE_ENV=production
PORT=4000

# Required managed data services. Use URL-encoded credentials.
DATABASE_URL=postgresql://motionmeet_app:<password>@postgres.example.com:5432/motionmeet?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=30
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
REDIS_URL=rediss://default:<password>@redis.example.com:6379
ALLOW_INSECURE_REDIS_TLS=false

FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
JWT_SECRET=REPLACE_ME

RUN_SCHEDULED_JOBS=true
RUN_MIGRATIONS=true
GLOBAL_RATE_LIMIT_PER_15_MIN=1000

# These capabilities are explicitly disabled until credentials are supplied.
MEDIA_UPLOADS_ENABLED=false
EMAIL_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Host port exposed by the production web container.
HTTP_PORT=80
