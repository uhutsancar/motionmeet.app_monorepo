# Copy to .env.production and replace every example value before deployment.
NODE_ENV=production
PORT=4000

# Required managed data services. Use URL-encoded credentials.
MONGODB_URL=mongodb+srv://motionmeet_app:<password>@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=motionmeet
MONGODB_APP_NAME=motionmeet-api
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_WAIT_QUEUE_TIMEOUT_MS=3000
MONGODB_MAX_TIME_MS=15000
MONGODB_MAX_IDLE_TIME_MS=30000
REDIS_URL=rediss://default:<password>@redis.example.com:6379
ALLOW_INSECURE_MONGO_TLS=false
ALLOW_INSECURE_REDIS_TLS=false

FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
JWT_SECRET=REPLACE_ME

RUN_SCHEDULED_JOBS=true
GLOBAL_RATE_LIMIT_PER_15_MIN=1000

# These capabilities are explicitly disabled until credentials are supplied.
MEDIA_UPLOADS_ENABLED=false
EMAIL_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Host port exposed by the production web container.
HTTP_PORT=80
