# Copy to .env.production and replace every example value before deployment.
NODE_ENV=production
PORT=4000

# Required managed data services. Use URL-encoded credentials.
DATABASE_URL=postgresql://motionmeet_app:<password>@postgres.example.com:5432/motionmeet?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=30
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
REDIS_URL=rediss://default:<password>@redis.example.com:6379
ALLOW_INSECURE_REDIS_TLS=false

FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
JWT_SECRET=REPLACE_ME

# Required for the API in production. Which hops in front of the API may say
# who the client is (X-Forwarded-For); every per-client rate limit and the
# address stored on a session depend on it. Either the number of proxies
# (TLS proxy or load balancer + the web container's nginx = 2), or - safer,
# because it cannot be fooled by a client that reaches nginx directly - the
# addresses those proxies connect from: IPs, CIDRs, or loopback / linklocal /
# uniquelocal. With Cloudflare in front, add Cloudflare's published ranges.
# Do not trust private ranges if nginx's port is reachable from the internet
# through Docker's userland proxy (clients would then appear as the gateway).
# See docs/operations/DEPLOYMENT.md, "Client addresses".
TRUST_PROXY=loopback,uniquelocal

# Worker threads that hash and check passwords (never the event loop). Leave
# one CPU of the API container to the event loop: CPUs - 1, at least 1.
PASSWORD_HASH_WORKERS=1

# The API process does neither in production: docker-compose.prod.yml runs
# migrations in the one-shot `migrate` service and housekeeping in the
# `scheduler` service. Outside compose, leave these false and run those entry
# points; `true` here would run migrations and every scheduled task in each
# API replica.
RUN_SCHEDULED_JOBS=false
RUN_MIGRATIONS=false
GLOBAL_RATE_LIMIT_PER_15_MIN=1000

# How committed outbox events leave PostgreSQL: `direct` (handled by the
# worker that claims them) or `rabbitmq` (needs RABBITMQ_URL, amqps://).
OUTBOX_TRANSPORT=direct
# RABBITMQ_URL=amqps://motionmeet:<password>@rabbitmq.example.com:5671/motionmeet

# Private ops listener (/metrics, /health/*). Keep it off the public proxy.
METRICS_PORT=9464
# false with a single API replica; true with more than one (sockets and rate
# limits are shared through Redis, so a replica without it is not ready).
READINESS_REQUIRE_REDIS=false

# Owner-cache serving; false only for the mixed-version window of a deploy
# that changes the cache format (docs/operations/DEPLOYMENT.md).
CACHE_READS_ENABLED=true
# Signed, expiring media URLs (ADR 003). false is a rollout rollback only.
MEDIA_SIGNED_DELIVERY=true
# Purge ImageKit's cache when deleted media leaves S3 (D-03). Check the plan's
# purge quota first.
IMAGEKIT_PURGE_ON_DELETE=false

# These capabilities are explicitly disabled until credentials are supplied.
MEDIA_UPLOADS_ENABLED=false
EMAIL_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Host port exposed by the production web container.
HTTP_PORT=80
