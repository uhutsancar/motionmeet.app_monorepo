public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react*

# pnpm re-resolves and re-links the whole workspace before every `pnpm run`,
# which costs 12s on a warm cache and over a minute under load - paid again on
# each dev server restart. CI still installs with --frozen-lockfile, so the
# lockfile contract stays enforced where it matters.
verify-deps-before-run=false
