{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**"],
      "env": ["VITE_BASEURL", "VITE_SOCKET_URL", "VITE_BUILD_SOURCEMAP", "EXPO_PUBLIC_API_URL"]
    },
    "@motionmeet/backend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@motionmeet/shared#build": {
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
