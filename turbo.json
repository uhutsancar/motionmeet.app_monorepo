{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**"],
      "env": ["VITE_BASEURL", "VITE_SOCKET_URL", "VITE_BUILD_SOURCEMAP", "EXPO_PUBLIC_API_URL", "EXPO_PUBLIC_WEB_URL"]
    },
    "@motionmeet/backend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@motionmeet/shared#build": {
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "@motionmeet/database-migration#typecheck": {
      "dependsOn": ["@motionmeet/shared#build"],
      "outputs": []
    },
    "@motionmeet/shared#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@motionmeet/backend#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["NODE_ENV", "DATABASE_URL", "JWT_SECRET", "FRONTEND_URL", "CORS_ORIGINS", "REDIS_URL", "MEDIA_UPLOADS_ENABLED", "EMAIL_ENABLED", "RUN_SCHEDULED_JOBS"]
    }
  }
}
